# A generated secret for Payload
PAYLOAD_SECRET=

# The public URL of your application (required for Cloudflare Workers deployment)
# Example: https://your-app.workers.dev or https://yourdomain.com
NEXT_PUBLIC_SERVER_URL=

# SMTP Email Configuration
# SMTP host (e.g., smtp.gmail.com, smtp-mail.outlook.com, smtp.sendgrid.net)
SMTP_HOST=

# SMTP port (usually 587 for TLS, 465 for SSL, 25 for non-secure)
SMTP_PORT=587

# Use secure connection (true for port 465, false for other ports)
SMTP_SECURE=false

# Optional: Email service provider (gmail, outlook, sendgrid, etc.)
# When specified, host and port may be auto-configured
SMTP_SERVICE=

# SMTP authentication credentials
SMTP_USER=
SMTP_PASS=

# Sender email configuration
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Anderson Properties
